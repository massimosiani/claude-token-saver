#!/usr/bin/env bash
# SessionStart hook for the claude-token-saver plugin.
# Reminds the user to run /claude-token-saver unless a CLAUDE.md already in context
# carries a Token Efficiency section.

set -euo pipefail

# Match the heading the skill emits, anchored: an unanchored match would let any passing
# mention of the phrase suppress the reminder forever.
has_rules() {
  [ -f "$1" ] && grep -q '^## Token Efficiency' "$1" 2>/dev/null
}

# Claude Code loads CLAUDE.md and CLAUDE.local.md from the working directory and every
# directory above it, so a session started in a subdirectory still has the repo root's
# rules in context. Walk up before falling back to the user-level file.
dir="$PWD"
while :; do
  for candidate in "$dir/CLAUDE.md" "$dir/.claude/CLAUDE.md" "$dir/CLAUDE.local.md"; do
    if has_rules "$candidate"; then
      exit 0
    fi
  done
  [ "$dir" = "/" ] && break
  dir="$(dirname "$dir")"
done

if has_rules "${HOME}/.claude/CLAUDE.md"; then
  exit 0
fi

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

message="No token-efficient rules found in CLAUDE.md. Run /claude-token-saver to add them."
escaped=$(escape_for_json "$message")

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"

exit 0
