#!/usr/bin/env bash
# SessionStart hook for the claude-token-saver plugin.
# Reminds the user to run /claude-token-saver when no token-efficient rules are in sight.
#
# This check is best-effort by design: it does not replicate Claude Code's memory loader.
# It cannot see rules that are path-scoped by `paths:` frontmatter or quoted inside a code
# fence, which make it go quiet; and it cannot follow an @-import, which makes it remind
# you about rules you already have. CLAUDE_TOKEN_SAVER_QUIET=1 silences it outright.
#
# Two rules keep it honest, both learned the hard way:
#   - Name the memory paths. Never recurse a whole directory: `grep -r` over ~/.claude
#     matches this plugin's own installed copy under plugins/cache, which silences the
#     reminder for every user who has the plugin.
#   - Walk up from the working directory. Anchoring on the git root misses a CLAUDE.md
#     below it, and lands in the wrong repo entirely for submodules or a git-managed $HOME.

set -euo pipefail

case "${CLAUDE_TOKEN_SAVER_QUIET:-}" in
  "" | 0 | false | no) ;;
  *) exit 0 ;;
esac

# CLAUDE.md and CLAUDE.local.md load from the working directory and every directory above
# it. `${dir%/*}` walks up without forking dirname per level.
targets=()
dir="$PWD"
while :; do
  targets+=("$dir/CLAUDE.md" "$dir/CLAUDE.local.md" "$dir/.claude/CLAUDE.md" "$dir/.claude/rules")
  [ "$dir" = "/" ] && break
  dir="${dir%/*}"
  [ -n "$dir" ] || dir="/"
done

# HOME can be unset under systemd units, containers and cron wrappers. Guarded, because
# `set -u` would otherwise abort the hook and the reminder would never print.
home="${HOME:-}"
if [ -n "$home" ]; then
  targets+=("$home/.claude/CLAUDE.md" "$home/.claude/rules")
fi

# Deliberately a loose match, not an anchored one. An anchored heading match leaves a user
# who wrote `## Token Efficiency Rules` with a reminder they cannot switch off. `-r` only
# ever descends the named rules directories, which are small.
if grep -rqs "Token Efficiency" "${targets[@]}"; then
  exit 0
fi

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "No token-efficient rules found in CLAUDE.md. Run /claude-token-saver to add them."\n  }\n}\n'

exit 0
