#!/usr/bin/env bash
# SessionStart hook for the claude-token-saver plugin.
# Checks whether any loaded CLAUDE.md has a Token Efficiency section; if none does,
# reminds the user to run /claude-token-saver.

set -euo pipefail

# Every documented location Claude Code loads a CLAUDE.md from, in load order.
# ./.claude/CLAUDE.md is as valid a project location as ./CLAUDE.md, so a project
# using it must not be nagged.
candidates=(
  "CLAUDE.md"
  ".claude/CLAUDE.md"
  "${HOME}/.claude/CLAUDE.md"
)

for candidate in "${candidates[@]}"; do
  if [ -f "$candidate" ] && grep -q "Token Efficiency" "$candidate" 2>/dev/null; then
    exit 0
  fi
done

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

message="No token-efficient rules found in CLAUDE.md. Run /claude-token-saver to add them."
escaped=$(escape_for_json "$message")

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$escaped"

exit 0
