#!/usr/bin/env bash
# SessionStart hook for the claude-token-saver plugin.
#
# Deliberately minimal. Earlier versions tried to work out which CLAUDE.md files Claude
# Code had actually loaded - walking parent directories, globbing rules directories,
# tracking code fences. Every mechanism added its own defects. The worst: a recursive
# scan of ~/.claude matched this plugin's own installed copy under plugins/cache and
# silenced the reminder for every user who had the plugin, and the fixtures written to
# catch that were blind to half of it.
#
# So this checks two named files and nothing else, and the reminder names the opt-out.
# That is the trade. It will sometimes remind someone who is already set up - rules in
# .claude/rules, reached through an @-import, or a session started in a subdirectory -
# and the cost of being wrong is one line of reading instead of a bug to fix.
#
# If you are tempted to make it smarter, read the four rounds of review on PR #3 first.

set -euo pipefail

# Any non-empty value silences the hook. Not a truthy test: an earlier version whitelisted
# "0", "false" and "no", which meant CLAUDE_TOKEN_SAVER_QUIET=off silenced it instead.
if [ -n "${CLAUDE_TOKEN_SAVER_QUIET:-}" ]; then
  exit 0
fi

for file in "$PWD/CLAUDE.md" "${HOME:-/nonexistent}/.claude/CLAUDE.md"; do
  if [ -f "$file" ] && grep -q "Token Efficiency" "$file" 2>/dev/null; then
    exit 0
  fi
done

# %s with a quoted argument, so the message never becomes part of the format string.
message="No token-efficient rules found in CLAUDE.md. Run /claude-token-saver to add them, or set CLAUDE_TOKEN_SAVER_QUIET=1 to silence this."
printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$message"

exit 0
